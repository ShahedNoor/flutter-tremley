	<string>Cette application nécessite l'accès à l'appareil photo pour vous permettre de prendre des photos ou de télécharger des images.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cette application nécessite l'accès à votre galerie pour vous permettre de choisir des photos ou de télécharger des images.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cette application nécessite l'accès au microphone pour capturer l'audio lors de l'enregistrement de vidéos.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tremley.customer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tremley</string>
				<string>com.tremley.customer</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>http</string>
		<string>https</string>
		<string>tel</string>
		<string>mailto</string>
	</array>
</dict>
</plist>
